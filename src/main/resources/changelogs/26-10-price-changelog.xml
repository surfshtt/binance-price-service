<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="26-10-price-1" author="fk8ght">
        <createTable tableName="prices">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_prices"/>
            </column>
            <column name="symbol" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="close_time" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="fetched_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="26-10-price-2" author="fk8ght">
        <addUniqueConstraint columnNames="symbol, close_time"
                             constraintName="uc_prices_symbol_close_time"
                             tableName="prices"/>
    </changeSet>
    <changeSet id="26-10-price-3" author="fk8ght">
        <createIndex indexName="idx_prices_symbol_fetched_at" tableName="prices">
            <column name="symbol"/>
            <column name="fetched_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
